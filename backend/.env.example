# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required for stable login sessions across backend restarts. Without it, a
# random secret is generated per-process and all logins are invalidated on
# restart. Generate one with: openssl rand -hex 32
LABNINJA_JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS. Defaults to
# http://localhost:4028 (this repo's dev port) if unset.
# LABNINJA_CORS_ORIGINS=http://localhost:4028

# Regex for additional allowed origins, on top of the exact list above. Needed
# for Vercel: every preview deployment gets its own random *.vercel.app
# subdomain that LABNINJA_CORS_ORIGINS can't enumerate in advance. Scope it to
# your project's prefix rather than all of *.vercel.app.
# LABNINJA_CORS_ORIGIN_REGEX=https://your-project-.*\.vercel\.app

# ── AI providers ─────────────────────────────────────────────────────────────
# Config-first, .env-fallback: each request normally carries the key the user
# configured on the browser's Config page (see modules/common/ai/), which takes
# priority. A key set here is used only when the client didn't send one --
# handy for local-only use so you don't have to configure Config at all, but be
# aware that on a deployment shared by multiple people, anyone without their own
# key will silently use (and bill) whichever key is set here.
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Generic OpenAI-compatible endpoint (Together.ai, Fireworks, a local LM
# Studio/vLLM server, etc.) for any provider not natively named above.
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_BASE_URL=
# CUSTOM_AI_MODEL=

# ── AI provider default ──────────────────────────────────────────────────────
# Which provider/model to use whenever the Config page's model is set to
# "Use .env default" (the default for new browsers). An explicit model chosen
# in Config still wins. With neither set, the built-in default is deepseek-chat.
# This file is read when NEXT_PUBLIC_BACKEND_MODE=fastapi; in nextjs-api mode
# set the same variables in frontend/.env instead.
# AI_PROVIDER: one of gemini, vertex, deepseek, groq, openai, anthropic,
#   openrouter, ollama, custom. vertex and ollama work only in fastapi mode.
#   custom always uses the CUSTOM_AI_* settings above for its model (AI_MODEL
#   is ignored for it). An unknown value is ignored.
# AI_MODEL: optional exact model id (e.g. gemini-2.5-pro, gpt-4o). If unset,
#   the provider's own default is used (e.g. anthropic -> claude-sonnet-5).
#   When both are set, AI_MODEL is sent as-is to AI_PROVIDER first (other keys
#   are only fallbacks) — set both for ids whose prefix doesn't name their
#   provider, e.g. AI_PROVIDER=openai + o3-mini, or AI_PROVIDER=groq +
#   openai/gpt-oss-120b. AI_MODEL alone is routed by its prefix (gpt-* ->
#   openai, claude-* -> anthropic, a/b -> openrouter, unknown -> Gemini first).
#   With AI_PROVIDER=ollama or vertex, a bare name is prefixed for you
#   (qwen2.5 -> ollama::qwen2.5, gemini-2.5-pro -> vertex_gemini_gemini-2.5-pro).
# AI_PROVIDER=gemini
# AI_MODEL=

# ── Voice (STT/TTS) ────────────────────────────────────────────────────────────
# Deepgram (cloud) is the default for both. Set to "local" to use on-device
# models instead: MLX-Whisper for STT (requires `ffmpeg` on PATH and the
# mlx-whisper package, `uv add mlx-whisper`) and macOS's `say` for TTS (macOS
# only, zero setup). Local has no per-request cost and no audio leaves the
# machine, at some cost to voice quality/accuracy vs. the cloud path.
# DEEPGRAM_API_KEY=
# VOICE_STT_PROVIDER=deepgram
# VOICE_TTS_PROVIDER=deepgram
# Override the local STT model (default: mlx-community/whisper-base-mlx).
# Smaller = faster/less accurate (whisper-tiny-mlx), larger = slower/more
# accurate (whisper-small-mlx and up).
# VOICE_STT_LOCAL_MODEL=

# ── Vertex AI (standard, OAuth2 — the ONLY path that spends GCP $300 credits) ──
# Selected in-app by choosing a model id prefixed "vertex_gemini_"
# (e.g. vertex_gemini_gemini-2.5-flash). Unlike the keys above, Vertex config is
# read server-side from here — the credentials are the deployment's, not the end
# user's. Requires a Google Cloud project with the Vertex AI API enabled and
# billing (your $300 trial) attached.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# Path to a service-account JSON key with the "Vertex AI User" role. If unset,
# Application Default Credentials are used (e.g. `gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=
