# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required for stable login sessions across backend restarts. Without it, a
# random secret is generated per-process and all logins are invalidated on
# restart. Generate one with: openssl rand -hex 32
LABNINJA_JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS. Defaults to
# http://localhost:4028 (this repo's dev port) if unset.
# LABNINJA_CORS_ORIGINS=http://localhost:4028

# Regex for additional allowed origins, on top of the exact list above. Needed
# for Vercel: every preview deployment gets its own random *.vercel.app
# subdomain that LABNINJA_CORS_ORIGINS can't enumerate in advance. Scope it to
# your project's prefix rather than all of *.vercel.app.
# LABNINJA_CORS_ORIGIN_REGEX=https://your-project-.*\.vercel\.app

# ── AI providers ─────────────────────────────────────────────────────────────
# NOTE: In normal app use, provider API keys ride from each user's BROWSER
# localStorage on every request (see modules/common/ai_client.py) and are NOT
# read from here. The two keys below are only for local backend testing
# (tests/gemini_test.py, tests/deepseek_test.py).
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# ── Vertex AI (standard, OAuth2 — the ONLY path that spends GCP $300 credits) ──
# Selected in-app by choosing a model id prefixed "vertex_gemini_"
# (e.g. vertex_gemini_gemini-2.5-flash). Unlike the keys above, Vertex config is
# read server-side from here — the credentials are the deployment's, not the end
# user's. Requires a Google Cloud project with the Vertex AI API enabled and
# billing (your $300 trial) attached.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# Path to a service-account JSON key with the "Vertex AI User" role. If unset,
# Application Default Credentials are used (e.g. `gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=
