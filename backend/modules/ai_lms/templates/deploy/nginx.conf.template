server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    # Lessons change whenever the class is re-exported: always revalidate HTML.
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }
}
