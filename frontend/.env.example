# frontend/.env.local — copy this file and fill in your values.
# .env.local is gitignored — never commit real secrets.
#
# The Config page (/config) has an "Import from .env" button that reads these
# and auto-fills the settings form. Restart the dev server (or redeploy) after
# making changes — Next.js reads env vars at startup, not at runtime.

# ── App wiring ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_MODE=Nextjs-api

# ── AI provider API keys (read by Config › Import from .env) ────────────────
# Config-first, .env-fallback: the browser's Config page takes priority; a key
# set here is used only when the client didn't send one (see fe-apis/ai/).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Generic OpenAI-compatible endpoint (Together.ai, Fireworks, a local LM
# Studio/vLLM server, etc.) for any provider not natively named above.
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
YOUTUBE_API_KEY=

# ── AI provider default (optional) ──────────────────────────────────────────
# Used whenever a Config model is "Use .env default" (the default for new
# browsers); an explicit model picked in Config always wins. This file is read
# in nextjs-api mode; in fastapi mode the backend reads backend/.env instead —
# set both if you switch modes.
# AI_PROVIDER: gemini | vertex | deepseek | groq | openai | anthropic |
#   openrouter | ollama | custom. Unset = deepseek-chat. vertex and ollama only
#   work with the FastAPI backend (NEXT_PUBLIC_BACKEND_MODE=fastapi). custom
#   takes its model from CUSTOM_AI_MODEL above, not AI_MODEL.
# AI_MODEL: optional exact model id; omit to use the provider's default model
#   (e.g. anthropic -> claude-sonnet-5). When both are set, AI_MODEL is sent
#   as-is to AI_PROVIDER first (other keys are only fallbacks) — set both for
#   ids whose prefix doesn't name their provider, e.g. AI_PROVIDER=openai +
#   o3-mini, or AI_PROVIDER=groq + openai/gpt-oss-120b. AI_MODEL alone is
#   routed by its prefix (unknown ids are tried on Gemini first).
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash

# ── Model / Ollama defaults (optional — can be set in Config UI instead) ─────
# TEXT_GENERATION_MODEL / ANSWER_MODEL are only read by Config › Import from
# .env, which pins that exact model in the browser (overriding AI_PROVIDER /
# AI_MODEL above); the server itself never reads them.
# TEXT_GENERATION_MODEL=deepseek-chat
# ANSWER_MODEL=deepseek-chat
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Voice (STT/TTS) ────────────────────────────────────────────────────────────
# Deepgram (cloud) is the default for both. Set to "local" to use on-device
# models instead: MLX-Whisper for STT (invoked via a Python subprocess -- see
# fe-apis/voice/localWhisper.ts -- requires ffmpeg on PATH and the backend's
# mlx-whisper dependency) and macOS's `say` for TTS (native to Node, macOS
# only). Must match the backend's own VOICE_STT_PROVIDER/VOICE_TTS_PROVIDER
# when NEXT_PUBLIC_BACKEND_MODE=fastapi, so both backends behave identically.
DEEPGRAM_API_KEY=
# VOICE_STT_PROVIDER=deepgram
# VOICE_TTS_PROVIDER=deepgram
