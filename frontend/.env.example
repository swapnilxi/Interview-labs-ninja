# frontend/.env.local — copy this file and fill in your values.
# .env.local is gitignored — never commit real secrets.
#
# The Config page (/config) has an "Import from .env" button that reads these
# and auto-fills the settings form. Restart the dev server (or redeploy) after
# making changes — Next.js reads env vars at startup, not at runtime.

# ── App wiring ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_MODE=Nextjs-api

# ── AI provider API keys (read by Config › Import from .env) ────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
YOUTUBE_API_KEY=

# ── Model / Ollama defaults (optional — can be set in Config UI instead) ─────
# TEXT_GENERATION_MODEL=gemini-flash-latest
# ANSWER_MODEL=gemini-flash-latest
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
