{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "fe-apis/*": [
        "./fe-apis/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-lint-scratch/types/**/*.ts",
    ".next-polish-a/types/**/*.ts",
    ".next-polish-b/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-polish-b3/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/modules/ai-lms/classes/*/AI-Bootcamp-reference"
  ]
}
